# Reklamı Fikir — Outreach Hafif MVP
# Kopyala: cp config/.env.example .env  ve değerleri doldur.

# === Google OAuth (Gmail + Sheets ortak) ===
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth token dosyasının yazılacağı yol (gitignored). outreach:auth bu dosyayı oluşturur.
GOOGLE_TOKEN_PATH=./tokens/iletisim.json

# === Google Sheets (CRM) ===
# Sheets URL'sindeki long ID: https://docs.google.com/spreadsheets/d/{ID}/edit
SHEETS_SPREADSHEET_ID=

# Sayfa adları (varsayılan değerler genelde değiştirilmez)
SHEETS_LEADS_TAB=Leads
SHEETS_SUPPRESSION_TAB=Suppression
SHEETS_SENDS_TAB=Sends

# === Gmail ===
# Shared mailbox adresi — outreach buradan gönderir, buradan cevap takip eder
GMAIL_FROM_ADDRESS=iletisim@reklamfikir.com
GMAIL_FROM_NAME=Reklamı Fikir

# Outreach draft'larına eklenecek Gmail label'ı (yoksa otomatik oluşur)
GMAIL_PENDING_LABEL=Outreach/Pending

# === Google Maps Places API ===
GOOGLE_MAPS_API_KEY=

# === Mail içeriği için sabitler ===
CALENDLY_URL=https://calendly.com/reklamfikir/kesif
DRIVE_PDF_URL=

# === KVKK Footer (compliance/footer.mjs içinde kullanılır) ===
COMPANY_LEGAL_NAME=Reklamı Fikir Dijital Danışmanlık
COMPANY_ADDRESS=
COMPANY_MERSIS=
KVKK_PAGE_URL=https://reklamfikir.com/kvkk

# === Çalıştırma davranışı ===
# Günlük yumuşak gönderim limiti (warm-up için)
DAILY_SEND_CAP=30
